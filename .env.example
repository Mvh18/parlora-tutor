# Parlora settings. Copy this file to `.env` (git-ignored) and change what you need.
# Every variable is optional: the values below are the defaults.
# Nested groups use a double underscore; lists are JSON.

# PostgreSQL, through the asyncpg driver. The local stack publishes it on port
# 5433 so it never collides with a PostgreSQL already running on the host.
PARLORA_DATABASE__URL=postgresql+asyncpg://parlora:parlora@localhost:5433/parlora

# Speech-to-text with faster-whisper (ADR 0002). The model is downloaded into the
# Hugging Face cache on first use. device: cuda or cpu (calls need cuda);
# compute_type: int8, int8_float16, float16 or float32; beam_size: 1-10.
PARLORA_STT__MODEL=large-v3-turbo
PARLORA_STT__DEVICE=cuda
PARLORA_STT__COMPUTE_TYPE=int8
PARLORA_STT__BEAM_SIZE=5

# The conversation model, through Ollama's native API (Ollama on the host). The
# model must be pulled first (`ollama pull <model>`). keep_alive is the number of
# seconds Ollama keeps it loaded after a request; -1 keeps it resident.
PARLORA_LLM__BASE_URL=http://host.docker.internal:11434
PARLORA_LLM__MODEL=qwen3:4b-instruct-2507-q4_K_M
PARLORA_LLM__NUM_CTX=4096
PARLORA_LLM__KEEP_ALIVE=-1

# onnxruntime provider for Kokoro text-to-speech: cuda or cpu. cuda is several
# times faster to first audio (docs/benchmarks.md); without a usable GPU the
# server falls back to the CPU and logs a warning.
PARLORA_TTS__PROVIDER=cuda

# Browser origins allowed to call the API, e.g. a course platform embedding
# Parlora. A JSON list of scheme://host[:port]; the wildcard "*" is rejected.
PARLORA_CORS_ORIGINS=["http://localhost:3000"]

# Host ports of the local stack (read by Docker Compose, not by the server).
# Bound to 127.0.0.1 only; the defaults avoid a Laravel app on 8000 and a
# PostgreSQL on 5432. If you change the PostgreSQL port, change the
# database URL above to match.
PARLORA_SERVER_HOST_PORT=8700
PARLORA_POSTGRES_HOST_PORT=5433
