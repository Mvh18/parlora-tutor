{
  "openapi": "3.1.0",
  "info": {
    "title": "Parlora API",
    "description": "Versioned HTTP API of Parlora, a local-first voice tutor. Every error is an RFC 9457 problem document (`application/problem+json`).",
    "version": "0.5.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up",
        "operationId": "health_live",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: every dependency is usable",
        "operationId": "health_ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable; `checks` says which.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/languages": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "Supported languages and their roles",
        "operationId": "catalogue_languages",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LanguageList"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cefr-levels": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "CEFR levels in order",
        "operationId": "catalogue_cefr_levels",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CefrLevelList"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calls/offer": {
      "post": {
        "tags": [
          "calls"
        ],
        "summary": "Start a call from a WebRTC offer",
        "operationId": "calls_offer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallOffer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallAnswer"
                }
              }
            }
          },
          "400": {
            "description": "The SDP offer could not be used, or it renegotiates a call.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The server holds its maximum number of calls (`/problems/call-limit`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The request body is too large.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "A voice dependency is not ready (`/problems/voice-unavailable`); `unavailable` lists which.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "calls"
        ],
        "summary": "Add ICE candidates to the call the offer started",
        "description": "Where Pipecat's small-WebRTC transport sends the candidates it gathers after the offer: the offer's URL, with the call in the body as `pc_id`.",
        "operationId": "calls_add_ice_candidates_to_offer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeerConnectionCandidates"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No active call has this id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calls/{call_id}": {
      "patch": {
        "tags": [
          "calls"
        ],
        "summary": "Add the client's ICE candidates to a call",
        "operationId": "calls_add_ice_candidates",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "The id the offer answered with.",
              "title": "Call Id"
            },
            "description": "The id the offer answered with."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IceCandidates"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No active call has this id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "calls"
        ],
        "summary": "End a call",
        "operationId": "calls_end",
        "parameters": [
          {
            "name": "call_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "The id the offer answered with.",
              "title": "Call Id"
            },
            "description": "The id the offer answered with."
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No active call has this id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Problem document (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallAnswer": {
        "properties": {
          "call_id": {
            "type": "string",
            "title": "Call Id",
            "description": "Id of the call for ICE candidates and ending it."
          },
          "pc_id": {
            "type": "string",
            "title": "Pc Id",
            "description": "The same id, under the name Pipecat's transport reads."
          },
          "sdp": {
            "type": "string",
            "title": "Sdp",
            "description": "SDP answer."
          },
          "type": {
            "type": "string",
            "const": "answer",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "call_id",
          "pc_id",
          "sdp",
          "type"
        ],
        "title": "CallAnswer"
      },
      "CallOffer": {
        "properties": {
          "sdp": {
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "title": "Sdp",
            "description": "SDP offer."
          },
          "type": {
            "type": "string",
            "const": "offer",
            "title": "Type"
          },
          "pc_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "description": "The id the offer answered with."
              },
              {
                "type": "null"
              }
            ],
            "title": "Pc Id",
            "description": "Null for a new call; renegotiating an existing one is not supported."
          },
          "restart_pc": {
            "type": "boolean",
            "title": "Restart Pc",
            "description": "Must be false: peer connections are not restarted.",
            "default": false
          },
          "requestData": {
            "$ref": "#/components/schemas/CallSettingsIn",
            "description": "The settings of the call."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sdp",
          "type",
          "requestData"
        ],
        "title": "CallOffer",
        "description": "An offer in the request shape of Pipecat's small-WebRTC transport.\n\nThe transport posts `{sdp, type, pc_id, restart_pc, requestData}` and nests the\ncaller's own data under `requestData`, here the call settings."
      },
      "CallSettingsIn": {
        "properties": {
          "target_language": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "title": "Target Language",
            "description": "Language practised in the call.",
            "examples": [
              "en"
            ]
          },
          "feedback_language": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{2}$",
                "examples": [
                  "en"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback Language",
            "description": "Language corrections are explained in; the target language when omitted."
          },
          "level": {
            "$ref": "#/components/schemas/CefrLevel",
            "description": "CEFR level of the learner."
          },
          "topic": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Topic",
            "description": "What the call is about."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_language",
          "level",
          "topic"
        ],
        "title": "CallSettings"
      },
      "CefrBand": {
        "type": "string",
        "enum": [
          "basic",
          "independent",
          "proficient"
        ],
        "title": "CefrBand",
        "description": "The three CEFR bands, each grouping two levels."
      },
      "CefrLevel": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ],
        "title": "CefrLevel",
        "description": "A CEFR level, ordered from A1 (lowest) to C2 (highest).\n\nLevels compare only with other levels, never with strings, so an ordering\nbug cannot hide behind lexicographic comparison."
      },
      "CefrLevelList": {
        "properties": {
          "levels": {
            "items": {
              "$ref": "#/components/schemas/CefrLevelOut"
            },
            "type": "array",
            "title": "Levels",
            "description": "From A1 (lowest) to C2 (highest)."
          }
        },
        "type": "object",
        "required": [
          "levels"
        ],
        "title": "CefrLevelList"
      },
      "CefrLevelOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "B1"
            ]
          },
          "band": {
            "$ref": "#/components/schemas/CefrBand"
          },
          "is_beginner": {
            "type": "boolean",
            "title": "Is Beginner",
            "description": "A1 and A2: feedback may use the native language."
          }
        },
        "type": "object",
        "required": [
          "code",
          "band",
          "is_beginner"
        ],
        "title": "CefrLevelOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IceCandidateIn": {
        "properties": {
          "candidate": {
            "type": "string",
            "maxLength": 1024,
            "title": "Candidate",
            "description": "Candidate line; empty marks the end of candidates."
          },
          "sdp_mid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mid"
          },
          "sdp_mline_index": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 64,
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mline Index"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate"
        ],
        "title": "IceCandidate"
      },
      "IceCandidates": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/IceCandidateIn"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Candidates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidates"
        ],
        "title": "IceCandidates"
      },
      "LanguageList": {
        "properties": {
          "languages": {
            "items": {
              "$ref": "#/components/schemas/LanguageOut"
            },
            "type": "array",
            "title": "Languages"
          }
        },
        "type": "object",
        "required": [
          "languages"
        ],
        "title": "LanguageList"
      },
      "LanguageOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "ISO 639-1 code.",
            "examples": [
              "en"
            ]
          },
          "english_name": {
            "type": "string",
            "title": "English Name"
          },
          "native_name": {
            "type": "string",
            "title": "Native Name"
          },
          "as_target": {
            "type": "boolean",
            "title": "As Target",
            "description": "Can be practised in a session."
          },
          "as_feedback": {
            "type": "boolean",
            "title": "As Feedback",
            "description": "Corrections can be explained in it."
          }
        },
        "type": "object",
        "required": [
          "code",
          "english_name",
          "native_name",
          "as_target",
          "as_feedback"
        ],
        "title": "LanguageOut"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version of the running server."
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Liveness"
      },
      "PeerConnectionCandidates": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/IceCandidateIn"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Candidates"
          },
          "pc_id": {
            "type": "string",
            "maxLength": 64,
            "title": "Pc Id",
            "description": "The id the offer answered with."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidates",
          "pc_id"
        ],
        "title": "PeerConnectionCandidates",
        "description": "Candidates sent to the offer URL, as Pipecat's transport does: the call is in the body."
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks",
            "description": "State of each dependency, keyed by name: `database` and the voice dependencies `stt`, `tts`, `llm` and `vad`, each `ok`, `loading`, `failed` or `disabled`. Clients must accept new keys and values.",
            "examples": [
              {
                "database": "ok",
                "llm": "ok",
                "stt": "ok",
                "tts": "ok",
                "vad": "ok"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "An RFC 9457 problem document; extra members carry problem-specific data.",
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "title": "Title",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "description": "Explanation specific to this occurrence.",
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "description": "Path of the request that caused the problem.",
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Request id to quote when reporting the error.",
            "title": "Request Id"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      }
    }
  }
}
